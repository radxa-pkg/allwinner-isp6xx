CUSTOM_DEBUILD_ARG := -aarm64

ISP_BUILD_DIR := $(CURDIR)/out/isp602
# Upstream puts libraries before objects, so keep their runtime dependencies.
ISP_BUILD_ARGS := CC=aarch64-linux-gnu-gcc AR=aarch64-linux-gnu-ar \
	CFLAGS="$(CFLAGS) -O2 -fPIC -DISP_VERSION=602" \
	LDFLAGS="$(LDFLAGS) -Wl,--no-as-needed -lm -lpthread" \
	ISP_VERSION=isp602 INSTALL_PREFIX=$(ISP_BUILD_DIR)/install

main_build:
	rm -rf "$(ISP_BUILD_DIR)"
	mkdir -p out
	cp -a isp6xx "$(ISP_BUILD_DIR)"
	# Keep the same algorithm archive as the upstream Debian build.
	cp "$(ISP_BUILD_DIR)/libisp/out/isp602_debian/glibc_64/gcc-arm-10.2-2020.11-x86_64-aarch64-none-linux-gnu/libisp_algo.a" \
		"$(ISP_BUILD_DIR)/libisp/out/isp602/glibc_64/libisp_algo.a"
	$(MAKE) -j1 -C "$(ISP_BUILD_DIR)/libisp" install $(ISP_BUILD_ARGS)
	$(MAKE) -j1 -C "$(ISP_BUILD_DIR)" install $(ISP_BUILD_ARGS)
	aarch64-linux-gnu-readelf -h "$(ISP_BUILD_DIR)/install/usr/lib/libAWIspApi.so" | grep -q AArch64

.PHONY: clean-isp602
clean: clean-isp602
clean-isp602:
	rm -rf "$(ISP_BUILD_DIR)" debian/libawispapi-isp-602-arm64/
